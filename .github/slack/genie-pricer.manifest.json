{
  "display_information": {
    "name": "genie-pricer",
    "description": "Add verified model pricing to GenAI Prices from a Slack mention."
  },
  "features": {
    "bot_user": {
      "display_name": "genie-pricer",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write"]
    }
  },
  "settings": {
    "socket_mode_enabled": false,
    "event_subscriptions": {
      "request_url": "https://team.pydantic.work/api/webhooks/slack/price-check",
      "bot_events": ["app_mention"]
    }
  }
}
