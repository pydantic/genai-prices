{
  "openapi": "3.1.0",
  "info": {
    "title": "genai-prices API",
    "version": "1.0.0",
    "description": "Prices one LLM API call. Send a `User-Agent` that starts with your client name and version."
  },
  "servers": [
    {
      "url": "https://genai-prices.pydantic.dev"
    }
  ],
  "security": [],
  "paths": {
    "/v1/price": {
      "post": {
        "operationId": "price",
        "summary": "Price one LLM API call",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The price.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "No provider or model matches.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "The request is not valid, or the usage cannot be priced.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PriceRequest": {
        "type": "object",
        "properties": {
          "model": {
            "description": "The model reference. Required, unless `response` names the model.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider_id": {
            "description": "The provider, such as `openai`. Send this or `provider_api_url`.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider_api_url": {
            "description": "The API URL of the provider. Send this or `provider_id`.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "api_flavor": {
            "description": "The extractor for `response`, such as `chat` or `responses`.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "timestamp": {
            "description": "The ISO 8601 time of the call. The default is now.",
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "price_context": {
            "description": "Strings that select a price variant, such as `service_tier`.",
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "usage": {
            "description": "Usage counts, such as `input_tokens`. Send this or `response`.",
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "response": {
            "description": "The raw provider response body. Send this or `usage`."
          }
        }
      },
      "PriceResponse": {
        "type": "object",
        "properties": {
          "input_price": {
            "type": "string",
            "description": "A decimal string, in US dollars."
          },
          "output_price": {
            "type": "string",
            "description": "A decimal string, in US dollars."
          },
          "total_price": {
            "type": "string",
            "description": "A decimal string, in US dollars."
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "model": {
            "$ref": "#/components/schemas/Model"
          },
          "model_price": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "The rates that priced the call, keyed by price key."
          },
          "usage": {
            "description": "The extracted usage. Only present for `response`.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": ["input_price", "output_price", "total_price", "provider", "model", "model_price"]
      },
      "Provider": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "Model": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          }
        },
        "required": ["title", "status", "detail"]
      }
    }
  }
}
